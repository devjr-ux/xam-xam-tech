rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────
    function isAuth()        { return request.auth != null; }
    function uid()           { return request.auth.uid; }
    function userRole()      { return get(/databases/$(database)/documents/users/$(uid())).data.role; }
    function isAdmin()       { return isAuth() && userRole() == 'admin'; }
    function isInstructor()  { return isAuth() && (userRole() == 'instructor' || userRole() == 'admin'); }
    function isOwner(userId) { return isAuth() && uid() == userId; }

    // ── Utilisateurs ──────────────────────────────────────
    match /users/{userId} {
      allow read:  if isAuth();
      allow create: if isAuth() && uid() == userId;
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Catégories (lecture publique) ─────────────────────
    match /categories/{id} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ── Cours ─────────────────────────────────────────────
    match /courses/{courseId} {
      allow read:  if resource.data.status == 'published' || isAuth();
      allow create: if isInstructor();
      allow update: if isAdmin()
                    || (isAuth() && resource.data.instructorId == uid())
                    || (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrollmentsCount']));
      allow delete: if isAdmin()
                    || (isAuth() && resource.data.instructorId == uid());

      // Sections
      match /sections/{sectionId} {
        allow read:  if true;
        allow write: if isAdmin()
                     || (isAuth() && get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == uid());

        // Leçons
        match /lessons/{lessonId} {
          allow read:  if true;
          allow write: if isAdmin()
                       || (isAuth() && get(/databases/$(database)/documents/courses/$(courseId)).data.instructorId == uid());
        }
      }
    }

    // ── Inscriptions ──────────────────────────────────────
    match /enrollments/{enrollmentId} {
      allow read:  if isAuth() && (
                     resource == null ||
                     resource.data.userId == uid() ||
                     isAdmin() ||
                     isInstructor()
                   );
      allow create: if isAuth() && request.resource.data.userId == uid();
      allow update: if isAuth() && (resource.data.userId == uid() || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Complétion des leçons ─────────────────────────────
    match /lesson_completions/{id} {
      allow read:  if isAuth() && (resource == null || resource.data.userId == uid());
      allow write: if isAuth() && request.resource.data.userId == uid();
    }

    // ── Quiz ──────────────────────────────────────────────
    match /quizzes/{quizId} {
      allow read:  if isAuth();
      allow write: if isInstructor();

      match /questions/{qId} {
        allow read:  if isAuth();
        allow write: if isInstructor();
      }
    }

    // ── Tentatives quiz ───────────────────────────────────
    match /quiz_attempts/{id} {
      allow read:  if isAuth() && (resource == null || resource.data.userId == uid());
      allow list:  if isAuth();
      allow create: if isAuth() && request.resource.data.userId == uid();
    }

    // ── Favoris ───────────────────────────────────────────
    match /favorites/{id} {
      allow read:  if isAuth() && (resource == null || resource.data.userId == uid());
      allow list:  if isAuth();
      allow create: if isAuth() && request.resource.data.userId == uid();
      allow delete: if isAuth() && resource.data.userId == uid();
    }

    // ── Certificats (lecture publique pour vérification) ──
    match /certificates/{id} {
      allow read:   if true;
      allow list:   if true;
      allow create: if isAuth() && request.resource.data.userId == uid();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Forum ─────────────────────────────────────────────
    match /forum_posts/{postId} {
      allow read:  if isAuth();
      allow create: if isAuth();
      allow update: if isAdmin()
                    || (isAuth() && resource.data.userId == uid());
      allow delete: if isAdmin();

      match /replies/{replyId} {
        allow read:  if isAuth();
        allow create: if isAuth();
        allow update: if isAdmin() || (isAuth() && resource.data.userId == uid());
      }
    }

    // ── Notifications ─────────────────────────────────────
    match /notifications/{id} {
      allow read:  if isAuth() && resource.data.userId == uid();
      allow write: if isAuth();
    }

    // ── Paramètres plateforme (admin uniquement) ───────────
    match /settings/{docId} {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }
  }
}
