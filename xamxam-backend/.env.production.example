APP_NAME="XamXam Tech"
APP_ENV=production
APP_KEY=base64:GENERE_PAR_RENDER
APP_DEBUG=false
APP_URL=https://xamxam-backend.onrender.com

LOG_CHANNEL=stderr
LOG_LEVEL=error

# PostgreSQL Render (DATABASE_URL est fourni automatiquement)
DB_CONNECTION=pgsql
DATABASE_URL=postgresql://user:password@host:5432/database

# CORS
FRONTEND_URL=https://xamxam-tech.vercel.app
SANCTUM_STATEFUL_DOMAINS=xamxam-tech.vercel.app

# Session / Cache
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DRIVER=local

# Mail (optionnel)
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@xamxamtech.com
MAIL_FROM_NAME="XamXam Tech"
